<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Spacing="5"
                    Margin="0,0,0,20">

            <TextBlock Text="Active Borrowings"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AppTextPrimaryBrush}"/>

            <TextBlock Text="View equipment currently borrowed by students."
                       FontSize="14"
                       Foreground="{StaticResource AppTextSecondaryBrush}"/>

        </StackPanel>

        <!-- Borrowing List -->
        <Border Grid.Row="1"
                Background="{StaticResource AppSidebarBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">

            <ListBox ItemsSource="{Binding Borrowings}"
                     SelectedItem="{Binding SelectedBorrowing}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="10">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Borrowing">

                        <Border Classes="itemCard"
                                Padding="15"
                                Margin="0,0,0,8"
                                Background="White"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">

                            <Grid ColumnDefinitions="80, *, 150">

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Id, StringFormat='#{0}'}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AppPrimaryBrush}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1"
                                            Spacing="4">

                                    <TextBlock Text="{Binding EquipmentId, StringFormat='Equipment ID: {0}'}"
                                               FontSize="16"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource AppTextPrimaryBrush}"/>

                                    <TextBlock Text="{Binding StudentId, StringFormat='Student ID: {0}'}"
                                               FontSize="14"
                                               Foreground="{StaticResource AppTextSecondaryBrush}"/>

                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding ExpectedReturnOn, StringFormat='Due: {0:yyyy-MM-dd}'}"
                                           Foreground="{StaticResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </Border>

        <!-- Actions and Message -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*, Auto"
              Margin="0,20,0,0">

            <TextBlock Grid.Column="0"
                       Text="{Binding Message}"
                       Classes="message"
                       Classes.error="{Binding IsError}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,20,0"/>

            <Button Grid.Column="1"
                    Content="Return Selected Borrowing"
                    Command="{Binding ReturnSelectedBorrowingCommand}"
                    Classes="primary"/>

        </Grid>

    </Grid>

</UserControl>

