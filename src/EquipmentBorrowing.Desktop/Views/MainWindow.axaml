<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Campus Equipment Borrowing System"
        Width="1000"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="250, *">

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="{StaticResource AppSidebarBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="20">

            <StackPanel Spacing="15">

                <!-- Application Title -->
                <TextBlock Text="Campus Equipment Borrowing System"
                           FontSize="20"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource AppTextPrimaryBrush}"
                           Margin="0,0,0,15"/>

                <!-- Navigation Buttons -->
                <Button Content="Equipment"
                        Command="{Binding ShowEquipmentCommand}"
                        Classes="nav"
                        Classes.active="{Binding IsEquipmentActive}"/>

                <Button Content="Active Borrowings"
                        Command="{Binding ShowBorrowingsCommand}"
                        Classes="nav"
                        Classes.active="{Binding IsBorrowingsActive}"/>

            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1"
                Background="White"
                Padding="40">

            <ContentControl Content="{Binding CurrentView}" />

        </Border>

    </Grid>

</Window>