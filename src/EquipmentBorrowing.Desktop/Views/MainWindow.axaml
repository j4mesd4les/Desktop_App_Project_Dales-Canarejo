<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Campus Equipment Borrowing System"
        Width="1000"
        Height="650"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="250, *">

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="#F8F9FA"
                BorderBrush="#DEE2E6"
                BorderThickness="0,0,1,0"
                Padding="20">

            <StackPanel Spacing="15">

                <!-- Application Title -->
                <TextBlock Text="Campus Equipment Borrowing System"
                           FontSize="20"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="#212529"
                           Margin="0,0,0,15"/>

                <!-- Navigation Buttons -->
                <Button Content="Equipment"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="15,10"
                        CornerRadius="4"/>

                <Button Content="Active Borrowings"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="15,10"
                        CornerRadius="4"/>

            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1"
                Background="#FFFFFF"
                Padding="40">

            <!-- Equipment View -->
            <ContentControl Content="{Binding EquipmentView}" />

        </Border>

    </Grid>

</Window>